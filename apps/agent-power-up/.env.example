# Production must use a PRIVATE Vercel Blob store. Connect it in Vercel Storage.
# The SDK supports the connected store's automatic OIDC authentication.
BLOB_STORE_ID=
# For local access to that store, alternatively use a scoped read/write token.
BLOB_READ_WRITE_TOKEN=
# Without either Blob variable, local development uses .data/ only.
AGENT_POWER_UP_DATA_DIR=
# Configure a random scheduler secret in Vercel, never in git.
CRON_SECRET=
# Optional aggregate operator readout: GET /api/operator/metrics, bearer auth.
OPERATOR_API_KEY=
# Optional Square sandbox. Never use a production token here.
SQUARE_ACCESS_TOKEN=
# Bind a seller credential to exactly one tenant; see your workspace node ID.
SQUARE_BUSINESS_ID=
