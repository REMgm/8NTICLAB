# --- Providers ---------------------------------------------------------
API_FOOTBALL_KEY=            # api-sports.io dashboard (primary provider)
FOOTBALL_DATA_TOKEN=         # fallback only, football-data.org
PROVIDER=api-football        # 'api-football' (default) | 'football-data'

# --- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, cron ingest. NEVER expose to client.

# --- Cron --------------------------------------------------------------
CRON_SECRET=                 # protects /api/cron/* routes
